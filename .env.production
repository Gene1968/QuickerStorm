# Staging bundle — typical host: https://genebiondo.com/main/games/QuickerStorm
VITE_APP_ENV=production
VITE_APP_NAME=QuickerStorm
ALLOWED_ORIGIN=https://genebiondo.com,https://quickerstorm.com,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

VITE_DEBUG=true
# Standalone hosting (Railway) serves from root — VITE_PATH unused in staging.
# VITE_PATH=/
# WebRTC signaling server — deploy signal-server.js and set this URL
# Example: wss://QuickerStorm-signal.up.railway.app
VITE_SIGNAL_URL=wss://QuickerStorm-production.up.railway.app
